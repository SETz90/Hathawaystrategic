NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://user:password@localhost:5432/hathaway_strategic?schema=public"

# Generate strong random secrets, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

CLIENT_URL=http://localhost:5173

COOKIE_DOMAIN=localhost

# Web Push (Phase 3.5.1). Generate a pair with `npx web-push generate-vapid-keys`.
# Push is skipped silently (with a startup warning) if these are left blank —
# the in-app/database notification system keeps working either way.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address the push services can reach if they need to (required by the spec).
VAPID_SUBJECT=mailto:support@hathawaystrategic.com

# Email (Phase 3.6). Uses Gmail SMTP via Nodemailer. Email is skipped silently
# (with a startup warning) if SMTP_EMAIL or SMTP_PASSWORD are left blank —
# in-app notifications and push keep working either way. SMTP_PASSWORD must be
# a Google App Password (https://myaccount.google.com/apppasswords), NOT your
# regular Gmail password — App Passwords require 2-Step Verification to be
# enabled on the account. Links inside emails are built from CLIENT_URL above.
SMTP_EMAIL=
SMTP_PASSWORD=
EMAIL_FROM="Hathaway Strategic <notifications@hathawaystrategic.com>"